generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum NotificationType {
  INFO
  ALERT
  WARNING
  SUCCESS
}

enum MonitorType {
  HTTP
  REDIS
  DATABASE
  TCP
  SSL
  DNS
  SMTP
  KAFKA
  GRPC
}

enum MonitorStatus {
  UNKNOWN
  UP
  DOWN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications    Notification[]
  monitors         Monitor[]
  stressTests      StressTest[]
  monitorSettings  UserMonitorSettings?
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model Monitor {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  type          MonitorType
  enabled       Boolean       @default(true)
  intervalSec   Int           @default(60)
  timeoutMs     Int           @default(10000)
  config        String
  lastStatus    MonitorStatus @default(UNKNOWN)
  lastError     String?
  lastLatencyMs Int?
  lastCheckedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([enabled, lastCheckedAt])
}

model UserMonitorSettings {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultIntervalSec Int      @default(60)
  defaultTimeoutMs   Int      @default(10000)
  notifyOnDown       Boolean  @default(true)
  notifyOnRecover    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum StressTestStatus {
  IDLE
  RUNNING
  PASSED
  FAILED
}

model StressTest {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  url            String
  method         String           @default("GET")
  vus            Int              @default(10)
  durationSec    Int              @default(30)
  expectedStatus Int              @default(200)
  p95Ms          Int?
  maxFailRate    Float?
  lastStatus     StressTestStatus @default(IDLE)
  lastError      String?
  lastSummary    String?
  lastRunAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  runs           StressTestRun[]

  @@index([userId, createdAt])
}

model StressTestRun {
  id           String           @id @default(uuid())
  stressTestId String
  stressTest   StressTest       @relation(fields: [stressTestId], references: [id], onDelete: Cascade)
  status       StressTestStatus
  error        String?
  summary      String?
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?

  @@index([stressTestId, startedAt])
}
