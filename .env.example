PORT=4000
NODE_ENV=development
DATABASE_URL="file:./data/pulsewatch.sqlite"
LOG_LEVEL=debug
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
CACHE_TTL_MS=15000
CACHE_USER_TTL_MS=60000
CACHE_MAX_ENTRIES=1000
REDIS_URL=redis://127.0.0.1:6379
JOBS_ENABLED=true
JOBS_CONCURRENCY=5
# Optional SMTP for alert emails (alertEmail in monitor settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=pulsewatch@localhost

